# SES Inventory App - Environment Variables
# ===========================================
# 
# For LOCAL DEVELOPMENT: Copy this to .env.local
# For PRODUCTION: Set in Vercel Dashboard:
# https://vercel.com/your-project/settings/environment-variables
#
# IMPORTANT: These are SERVER-SIDE variables (no REACT_APP_ prefix)
# They are accessed by Vercel serverless functions, not the browser

# ============================================
# REQUIRED: Anthropic API Key
# ============================================
# Used for: AI-powered coin identification
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================
# REQUIRED: eBay API Credentials  
# ============================================
# Used for: Market price lookups (sold listings)
# Get from: https://developer.ebay.com/my/keys
EBAY_APP_ID=YourAppName-Production-xxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: Additional APIs
# ============================================
# Gold API (backup for spot prices if metals.live is down)
# Get from: https://www.goldapi.io/
# GOLD_API_KEY=goldapi-xxxxx
